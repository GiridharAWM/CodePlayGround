<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>CodeVisualizationPlayground</display-name>
    <description>Web-based Java Code Execution and Visualization Platform</description>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>playground.jsp</welcome-file>
    </welcome-file-list>

    <!-- 1. Run Code Servlet -->
    <servlet>
        <servlet-name>RunCodeServlet</servlet-name>
        <servlet-class>com.codevisualizer.RunCodeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RunCodeServlet</servlet-name>
        <url-pattern>/run-code</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RunCodeServlet</servlet-name>
        <url-pattern>/RunCodeServlet</url-pattern>
    </servlet-mapping>

    <!-- 2. Register Servlet -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.codevisualizer.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/RegisterServlet</url-pattern>
    </servlet-mapping>

    <!-- 3. Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.codevisualizer.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <!-- 4. Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.codevisualizer.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <!-- 5. Save Program Servlet -->
    <servlet>
        <servlet-name>SaveProgramServlet</servlet-name>
        <servlet-class>com.codevisualizer.SaveProgramServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SaveProgramServlet</servlet-name>
        <url-pattern>/save-program</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SaveProgramServlet</servlet-name>
        <url-pattern>/SaveProgramServlet</url-pattern>
    </servlet-mapping>

    <!-- 6. Load Program Servlet -->
    <servlet>
        <servlet-name>LoadProgramServlet</servlet-name>
        <servlet-class>com.codevisualizer.LoadProgramServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoadProgramServlet</servlet-name>
        <url-pattern>/load-program</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoadProgramServlet</servlet-name>
        <url-pattern>/LoadProgramServlet</url-pattern>
    </servlet-mapping>

    <!-- 7. Delete Program Servlet -->
    <servlet>
        <servlet-name>DeleteProgramServlet</servlet-name>
        <servlet-class>com.codevisualizer.DeleteProgramServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteProgramServlet</servlet-name>
        <url-pattern>/delete-program</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeleteProgramServlet</servlet-name>
        <url-pattern>/DeleteProgramServlet</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>60</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

</web-app>
